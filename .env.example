# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# JWT_SECRET: Optional secret key for signing session tokens (falls back to a random runtime secret if omitted).
JWT_SECRET=

# ADMIN_INVITE_CODE: Optional invite code allowing municipal administrator registration.
ADMIN_INVITE_CODE=

# PORT: Server port (defaults to 3000).
PORT=3000

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for the Real-Time Priority Map.
VITE_GOOGLE_MAPS_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
